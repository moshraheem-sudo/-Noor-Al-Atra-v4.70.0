<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingLeft="2dp"
    android:paddingRight="2dp"
    android:weightSum="4">

    <!-- Fajr (الفجر) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/notification_prayer_tile_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الفجر"
            android:textColor="@color/notification_prayer_title"
            android:textSize="11.5sp"
            android:maxLines="1"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_fajr_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/notification_prayer_time"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Sunrise (الشروق) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/notification_prayer_tile_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الشروق"
            android:textColor="@color/notification_prayer_title"
            android:textSize="11.5sp"
            android:maxLines="1"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_sunrise_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/notification_prayer_time"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Dhuhr (الظهر) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/notification_prayer_tile_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الظهر"
            android:textColor="@color/notification_prayer_title"
            android:textSize="11.5sp"
            android:maxLines="1"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_dhuhr_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/notification_prayer_time"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Maghrib (المغرب) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/notification_prayer_tile_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="المغرب"
            android:textColor="@color/notification_prayer_title"
            android:textSize="11.5sp"
            android:maxLines="1"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_maghrib_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/notification_prayer_time"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
